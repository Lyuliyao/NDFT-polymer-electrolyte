units           lj
atom_style      full
boundary        p p p

variable        T      index 1.0
variable        seed   index 91237
variable        nsteps index 60000

read_data       ${data}

bond_style      fene
bond_coeff      1 30.0 1.5 1.0 1.0
special_bonds   fene

pair_style      soft 1.795939277
pair_coeff      1 1 0.0 1.122462048
pair_coeff      1 2 0.0 0.785723434
pair_coeff      1 3 0.0 1.459200663
pair_coeff      2 2 0.0 0.448984819
pair_coeff      2 3 0.0 1.122462048
pair_coeff      3 3 0.0 1.795939277

neighbor        0.4 bin
neigh_modify    delay 0 every 1 check yes

velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
variable        pref equal ramp(0.0,60.0)
fix             adp all adapt 1 pair soft a * * v_pref
fix             int all nve/limit 0.05
fix             lan all langevin ${T} ${T} 1.0 ${seed} zero yes

compute         bmax all bond/local dist
variable        lmpver equal version
if "${lmpver} >= 20231121" then &
   "compute bstat all reduce max c_bmax inputs local" &
else &
   "compute bstat all reduce max c_bmax"
thermo_style    custom step temp epair press v_pref c_bstat
thermo          2000
timestep        0.005
run             ${nsteps}

write_restart   ${out}
