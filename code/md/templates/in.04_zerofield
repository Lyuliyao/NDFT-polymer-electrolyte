units           lj
atom_style      full
boundary        p p p

variable        T       index 1.0
variable        Lt      index 0.0
variable        nequil  index 100000
variable        nsteps  index 4000000
variable        ndump   index 200

read_restart    ${restart}
include         ${ff}

velocity        all zero linear

print           "rescaling box: lx = $(lx) -> ${Lt}"
change_box      all x final 0.0 ${Lt} y final 0.0 ${Lt} z final 0.0 ${Lt} remap units box

fix             int all nvt temp ${T} ${T} 1.0
timestep        0.005
thermo_style    custom step temp epair ebond elong press vol
thermo          5000
run             ${nequil}

reset_timestep  0
compute         msdcat cations msd
compute         msdani anions  msd
fix             msdout all ave/time ${ndump} 1 ${ndump} &
                c_msdcat[4] c_msdani[4] file msd.dat &
                title2 "# step msd_cation msd_anion"

dump            dions ions custom ${ndump} ions.dump id type xu yu zu fx fy fz
dump_modify     dions sort id format line "%d %d %.4f %.4f %.4f %.5g %.5g %.5g"

fix             thermolog all ave/time 200 5 1000 c_thermo_temp c_thermo_press &
                file thermo.dat title2 "# step temp press"
run             ${nsteps}

write_restart   ${out}
