# Zero-field replica (2026-10-06): as in.04_zerofield, started from the NPT restart with fresh Gaussian velocities
# (one seed per replica) and a long equilibration (5000 tau) so that the replicas decorrelate; then NVT production
# at the mean NPT volume with the ion positions dumped every ndump steps (tools/zf_modes.py takes the Fourier modes).
units           lj
atom_style      full
boundary        p p p

variable        T       index 1.0
variable        Lt      index 0.0        # target box edge from the NPT mean
variable        nequil  index 1000000
variable        nsteps  index 8000000
variable        ndump   index 1000
variable        seed    index 1

read_restart    ${restart}
include         ${ff}

velocity        all create ${T} ${seed} dist gaussian
velocity        all zero linear

print           "rescaling box: lx = $(lx) -> ${Lt}"
change_box      all x final 0.0 ${Lt} y final 0.0 ${Lt} z final 0.0 ${Lt} remap units box

fix             int all nvt temp ${T} ${T} 1.0
timestep        0.005
thermo_style    custom step temp epair elong press
thermo          10000
run             ${nequil}

reset_timestep  0
dump            dions ions custom ${ndump} ions.dump id type xu yu zu
dump_modify     dions sort id format line "%d %d %.4f %.4f %.4f"
run             ${nsteps}
