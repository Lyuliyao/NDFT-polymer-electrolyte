# Continue a zero-field run to a longer total length, appending to its dump.
# Used when the first 2e4 tau are too short to measure tau_int(m=3) directly,
# which is the case once D_+ drops below about 1.5e-3 (c >= 0.08).
#
# The job script truncates ions.dump back to the restart's timestep first, so
# appending neither repeats nor skips a frame.  The restart carries the
# velocities and the Nose-Hoover state, so this is a continuation of the same
# trajectory, not a new one; `velocity all zero linear` only removes the drift
# that PPPM can accumulate, as at the start of any production stage.
units           lj
atom_style      full
boundary        p p p

variable        T       index 1.0
variable        target  index 12000000   # absolute timestep to run up to
variable        ndump   index 200
variable        nrst    index 1000000
variable        seg     index 1

read_restart    ${restart}
include         ${ff}

velocity        all zero linear

fix             int all nvt temp ${T} ${T} 1.0
timestep        0.005
thermo_style    custom step temp epair ebond elong press vol
thermo          5000

compute         msdcat cations msd
compute         msdani anions  msd
fix             msdout all ave/time ${ndump} 1 ${ndump} &
                c_msdcat[4] c_msdani[4] file msd.${seg}.dat &
                title2 "# step msd_cation msd_anion"

dump            dions ions custom ${ndump} ions.dump id type xu yu zu fx fy fz
dump_modify     dions sort id format line "%d %d %.4f %.4f %.4f %.5g %.5g %.5g" append yes

fix             thermolog all ave/time 200 5 1000 c_thermo_temp c_thermo_press &
                file thermo.${seg}.dat title2 "# step temp press"

restart         ${nrst} restart.zf.*

run             ${target} upto
write_restart   ${out}
