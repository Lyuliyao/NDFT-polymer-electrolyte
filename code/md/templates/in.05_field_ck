units           lj
atom_style      full
boundary        p p p

variable        T       index 1.0
variable        ntrans  index 1100000
variable        nsteps  index 11000000
variable        ndump   index 200
variable        binw    index 0.1
variable        nrep    index 100
variable        nblock  equal ${ndump}*${nrep}
variable        resume  index 0
variable        seg     index 0
variable        nrst    index 500000

read_restart    ${restart}
include         ${ff}
include         ${potfile}

if "${resume} == 0" then "velocity all zero linear" "reset_timestep 0"

fix             int all nvt temp ${T} ${T} 1.0
timestep        0.005

fix             extc cations addforce 0.0 0.0 v_fz_cat energy v_ez_cat
fix             exta anions  addforce 0.0 0.0 v_fz_ani energy v_ez_ani
fix_modify      extc energy yes
fix_modify      exta energy yes

thermo_style    custom step temp epair elong press vol f_extc f_exta
thermo          5000

if "${resume} != 1" then "restart ${nrst} trans.*" "run ${ntrans} upto" "restart 0" "reset_timestep 0"


compute         ckcat cations chunk/atom bin/1d z lower ${binw} units box
compute         ckani anions  chunk/atom bin/1d z lower ${binw} units box
fix             pcat cations ave/chunk ${ndump} ${nrep} ${nblock} ckcat &
                density/number fz v_fz_cat file prof_cat.${seg}.dat
fix             pani anions  ave/chunk ${ndump} ${nrep} ${nblock} ckani &
                density/number fz v_fz_ani file prof_ani.${seg}.dat

dump            dcat cations custom ${ndump} cat.dump id type x y z fx fy fz v_fz_cat
dump_modify     dcat sort id format line "%d %d %.4f %.4f %.4f %.5g %.5g %.5g %.5g"
dump            dani anions custom ${ndump} ani.dump id type x y z fx fy fz v_fz_ani
dump_modify     dani sort id format line "%d %d %.4f %.4f %.4f %.5g %.5g %.5g %.5g"

if "${resume} == 1" then "dump_modify dcat append yes" "dump_modify dani append yes"

variable        vzc equal vcm(cations,z)
variable        vza equal vcm(anions,z)
fix             curout all ave/time 200 5 1000 v_vzc v_vza c_thermo_temp c_thermo_press &
                file current.${seg}.dat title2 "# step vcm_z_cat vcm_z_ani temp press"

restart         ${nrst} restart.*

run             ${nsteps} upto
write_restart   ${out}
