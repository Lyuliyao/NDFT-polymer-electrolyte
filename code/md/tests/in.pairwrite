# Dump the implemented ion-monomer and ion-ion pair potentials via pair_write
units           lj
atom_style      full
boundary        p p p
region          box block 0 40 0 40 0 40
create_box      3 box bond/types 1 extra/bond/per/atom 2 extra/special/per/atom 4
create_atoms    1 single 1.0 1.0 1.0
create_atoms    2 single 3.0 1.0 1.0
create_atoms    3 single 5.0 1.0 1.0
mass            * 1.0
include         ${ff}
run             0 post no
pair_write      1 2 2000 r 0.40 5.00 pw_cat_mono.dat CATMONO 0.0 7.725213
pair_write      1 3 2000 r 0.60 5.00 pw_ani_mono.dat ANIMONO 0.0 -7.725213
pair_write      2 3 2000 r 0.60 5.00 pw_cat_ani.dat  CATANI  7.725213 -7.725213
pair_write      1 1 2000 r 0.60 2.50 pw_mono_mono.dat MONOMONO 0.0 0.0
