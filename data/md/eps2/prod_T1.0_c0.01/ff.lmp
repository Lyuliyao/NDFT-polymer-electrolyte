variable tabfile index solvation.table

bond_style      fene
bond_coeff      1 30.0 1.5 1.0 1.0
special_bonds   fene

pair_style      hybrid/overlay lj/cut 2.0 lj/cut/coul/long 2.0 5.0 table linear 100000

pair_coeff      1 1 lj/cut 1.0 1 2
pair_coeff      1 2 lj/cut 1.0 0.7 0.7857234338
pair_coeff      1 3 lj/cut 1.0 1.3 1.459200663
pair_coeff      2 2 lj/cut/coul/long 1.0 0.4 0.4489848193
pair_coeff      2 3 lj/cut/coul/long 1.0 1 1.122462048
pair_coeff      3 3 lj/cut/coul/long 1.0 1.6 1.795939277

pair_modify     shift yes

pair_coeff      1 2 table ${tabfile} SIG1_MONO 5.0
pair_coeff      1 3 table ${tabfile} SIG1_MONO 5.0

dielectric      2
variable        pppm_acc index 1.0e-4
kspace_style    pppm ${pppm_acc}

set             type 1 charge 0.000000
set             type 2 charge 7.725213
set             type 3 charge -7.725213

group           monomers type 1
group           cations  type 2
group           anions   type 3
group           ions     type 2 3

neighbor        0.4 bin
neigh_modify    delay 0 every 1 check yes
